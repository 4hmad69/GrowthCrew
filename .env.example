GROWTHCREW_APP_NAME=GrowthCrew API
GROWTHCREW_APP_VERSION=0.3.0
GROWTHCREW_ENVIRONMENT=development
GROWTHCREW_API_V1_PREFIX=/api/v1
GROWTHCREW_LOG_LEVEL=INFO
GROWTHCREW_BACKEND_URL=http://127.0.0.1:8000
GROWTHCREW_HTTP_TIMEOUT_SECONDS=5.0

GROWTHCREW_POSTGRES_DB=growthcrew
GROWTHCREW_POSTGRES_USER=growthcrew
GROWTHCREW_POSTGRES_PASSWORD=local-development-only-change-before-sharing
GROWTHCREW_POSTGRES_PORT=5432

GROWTHCREW_DATABASE_URL=postgresql+psycopg://growthcrew:local-development-only-change-before-sharing@127.0.0.1:5432/growthcrew

GROWTHCREW_DATABASE_ECHO=false
GROWTHCREW_DATABASE_POOL_SIZE=5
GROWTHCREW_DATABASE_MAX_OVERFLOW=5
GROWTHCREW_DATABASE_POOL_TIMEOUT_SECONDS=30
GROWTHCREW_DATABASE_POOL_RECYCLE_SECONDS=1800
GROWTHCREW_DATABASE_CONNECT_TIMEOUT_SECONDS=5